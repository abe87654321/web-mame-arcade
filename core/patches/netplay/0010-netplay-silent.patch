+void video_manager::present_frame()
+{
+	// Commit the textures/quads for the frame that has already been drawn by
+	// the emulation step, then ask the OSD to present. Deliberately does not
+	// call finish_screen_updates(): that can run screen_update, and the screen
+	// partial-scan state is part of the save buffer / cross-peer hash.
+	for (device_video_output_interface &output : video_output_interface_enumerator(machine().root_device()))
+		output.video_output_update();
+	machine().osd().update(false);
+}
+
+
 void video_manager::frame_update(bool from_debugger)
