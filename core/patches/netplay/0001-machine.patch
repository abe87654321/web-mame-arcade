@@ -1404,6 +1405,25 @@ void running_machine::emscripten_main_loop()
 
 	auto profile = g_profiler.start(PROFILER_EXTRA);
 
+	// Netplay owns the frame clock: step exactly one game frame (its real screen
+	// period) once every player's input for that frame is present, otherwise pump
+	// video and wait. When netplay is inactive the stock 60Hz path below is used.
+	if (netplay_input_active())
+	{
+		// Present every displayed frame. Rollback can step on every animation
+		// tick (it predicts instead of waiting), so presenting only on the
+		// "not ready" branch would freeze video while audio keeps playing.
+		// `netplay_present_frame` only commits textures + OSD; it deliberately
+		// skips frame_update's input/notifier/throttle side effects.
+		netplay_try_run_frame(*machine, netplay_next_frame());
+		if (!netplay_is_silent())
+			netplay_present_frame();
+
+		if (machine->exit_pending())
+			emscripten_cancel_main_loop();
+		return;
+	}
+
 	// execute CPUs if not paused
 	if (!machine->m_paused)
