+//-------------------------------------------------
+//  buffer_size - bytes needed by write_buffer /
+//  read_buffer, so callers can size an in-memory
+//  state snapshot
+//-------------------------------------------------
+
+size_t save_manager::buffer_size() const
+{
+	size_t total_size = HEADER_SIZE;
+	for (auto const &entry : m_entry_list)
+		total_size += entry->m_typesize * entry->m_typecount * entry->m_blockcount;
+	return total_size;
+}
+
