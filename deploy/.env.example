# Copy to deploy/.env (gitignored) before `docker compose ... up`.

# --- PostgreSQL (T36; local dev) --------------------------------------------
# Backs accounts, catalogue, matches, scores and the anti-cheat `match_flags`.
# POSTGRES_PASSWORD is required; generate with: openssl rand -hex 16
# Apply the schema with:
#   WMA_PG_URL=postgres://wma:<password>@localhost:5432/wma \
#     pnpm --filter @wma/api migrate
POSTGRES_USER=wma
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wma

# coturn shared secret for time-limited ("TURN REST API") credentials. The API
# mints short-lived username/credential pairs with this secret (T34); nothing
# else needs it. Generate with: openssl rand -hex 32
TURN_SECRET=change-me

# Public realm carried in TURN credentials.
TURN_REALM=web-mame-arcade

# Public IP of the TURN host. Use 127.0.0.1 for a purely local test.
TURN_EXTERNAL_IP=127.0.0.1

# --- Browser ICE configuration (Vite build env) -----------------------------
# Reference values for a browser build's Vite env (Vite reads VITE_* from its
# own project root, not this file). With `use-auth-secret`, TURN credentials are
# HMAC-minted per session from TURN_SECRET; the static pair below will not
# authenticate against this coturn until the API issues real ones (T34).
VITE_STUN_URL=stun:localhost:3478
VITE_TURN_URL=turn:localhost:3478
VITE_TURN_USERNAME=dev
VITE_TURN_CREDENTIAL=dev

# --- LiveKit A/V fallback (T41) ---------------------------------------------
# The relay mints LiveKit access tokens with this key/secret; browsers reach the
# server at LIVEKIT_URL. Generate the secret with: openssl rand -hex 32
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long
